{
  "name": "gitpeek",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "start:release": "tauri dev --release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "package:zip": "powershell -NoProfile -Command \"(Get-Item src-tauri/build.rs).LastWriteTime = Get-Date\" && npm run tauri build && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force -Path dist-zip | Out-Null; Compress-Archive -Path 'src-tauri/target/release/GitPeek.exe' -DestinationPath 'dist-zip/GitPeek-portable.zip' -Force\"",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "backup:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-github.ps1"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/types": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
